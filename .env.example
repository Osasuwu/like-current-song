# Optional. Everything here can be typed into the app instead, under
# Connected services — a build with no .env at all is fully usable.
#
# These values only seed a field the app has never been told about. Whatever
# you save in Connected services wins from then on, and a cleared field stays
# cleared across rebuilds.
#
# Build with: flutter build apk --release --dart-define-from-file=.env

# Spotify Developer App — https://developer.spotify.com/dashboard
# Redirect URI is fixed at likespotify://auth-callback (the app's intent
# filter); add it in the dashboard, there is nothing to configure here.
SPOTIFY_CLIENT_ID=your_spotify_client_id

# YouTube Music — a Google Cloud OAuth client of the "TV and Limited Input"
# kind, with the YouTube Data API enabled. Leave both out to sign in with a
# client you paste into the app instead.
YTMUSIC_CLIENT_ID=your_google_client_id
YTMUSIC_CLIENT_SECRET=your_google_client_secret

# Shared like counter — a Google Sheet you own. You do not need to make one to
# fill this in: sign in under Connected services and press "Create spreadsheet"
# and the app builds it, tabs and headers and all, in your Drive.
# Set this only to point the build at a sheet that already exists (a second
# device joining an existing count). The id is the long part of the sheet's
# URL, between /d/ and /edit. Leave it out to count likes on this device only.
COUNTER_SPREADSHEET_ID=your_spreadsheet_id

# The counter signs in to Google separately from YouTube Music, with the
# spreadsheets scope. The same OAuth client works for both, once the Google
# Sheets API is enabled on its project.
COUNTER_GOOGLE_CLIENT_ID=your_google_client_id
COUNTER_GOOGLE_CLIENT_SECRET=your_google_client_secret
